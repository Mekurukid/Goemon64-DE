  "1089": "bei der Wahrsagerin.",
  "1090": "Mein Traum war es,",
  "1091": "oben auf dem Mt.Fuji",
  "1092": "mit 100 Freunden essen.",
  "1093": "Nun,",
  "1094": "endlich bin ich auf",
  "1095": "oben auf Mt.Fuji!",
  "1096": "Zur Erinnerung",
  "1097": "ging ich zum Pfeifenmacher,",
  "1098": "eine Pfeife.",
  "1099": "Ein seltsamer Strahl traf",
  "1100": "Oedo-Burg,",
  "1101": "und machte sie zur Europaburg.",
  "1102": "Trifft mich der Strahl",
  "1103": "werde ich dann zum Muster-",
  "1104": "EU-Buerger?",
  "1105": "Prinzessin Yuki sagte,",
  "1106": "dass etwas Seltsames",
  "1107": "in Oedo-Burg passiert...",
  "1108": "Ich muss unbedingt",
  "1109": "die Kloesse sehen, die durch",
  "1110": "den Flur!",
  "1111": "Ob man sie",
  "1112": "essen kann?",
  "1113": "Ich sah etwas Seltsames",
  "1114": "am westlichen",
  "1115": "im Westhimmel.",
  "1116": "Nach einer Weile",
  "1117": "fingen auch meine Augen an",
  "1118": "huepfen",
  "1119": "Huepf, huepf, huepf,",
  "1120": "huepf, huepf, huepf,",
  "1121": "huepf, huepf, huepf...",
  "1122": "Aaaah!",
  "1123": "Mir drehts!",
  "1124": "Chuppy:Bin ich muede...",
  "1125": "Ich will nur schnell",
  "1126": "essen und ins Bett, wuff!",
  "1127": "Chuppy:Muede, wuff!",
  "1128": "Chuppy:Laufen, laufen,",
  "1129": "laufen, laufen, laufen,",
  "1130": "laufen, laufen, laufen...",
  "1131": "Ich kann nicht mehr, wuff!",
  "1132": "Chuppy:Grrrrrrrr...",
  "1133": "Ich bin hungrig,",
  "1134": "das reicht mir langsam,",
  "1135": "Wuff",
  "1136": "UFO?",
  "1137": "Ha, ha, ha, ha, ha...",
  "1138": "Ist unser Chuppy nicht",
